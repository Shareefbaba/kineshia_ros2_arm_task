<?xml version="1.0"?>
<robot name="planar_arm">

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry><cylinder radius="0.2" length="0.2"/></geometry>
      <material name="gray"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry><cylinder radius="0.2" length="0.2"/></geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/>
    </inertial>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="3.14159" effort="100" velocity="3.0"/>
  </joint>

  <link name="link1">
    <visual>
      <origin xyz="1.5 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.08" length="3.0"/></geometry>
      <material name="blue"><color rgba="0.2 0.4 0.9 1"/></material>
    </visual>
    <collision>
      <origin xyz="1.5 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.08" length="3.0"/></geometry>
    </collision>
    <inertial>
      <origin xyz="1.5 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="1.5" iyz="0" izz="1.5"/>
    </inertial>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="3.0 0 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-2.0944" upper="2.0944" effort="100" velocity="3.0"/>
  </joint>

  <link name="link2">
    <visual>
      <origin xyz="1.0 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.07" length="2.0"/></geometry>
      <material name="green"><color rgba="0.2 0.8 0.3 1"/></material>
    </visual>
    <collision>
      <origin xyz="1.0 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.07" length="2.0"/></geometry>
    </collision>
    <inertial>
      <origin xyz="1.0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.03" ixy="0" ixz="0" iyy="0.6" iyz="0" izz="0.6"/>
    </inertial>
  </link>

  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="2.0 0 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-2.0944" upper="2.0944" effort="100" velocity="3.0"/>
  </joint>

  <link name="link3">
    <visual>
      <origin xyz="0.75 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.06" length="1.5"/></geometry>
      <material name="red"><color rgba="0.9 0.3 0.2 1"/></material>
    </visual>
    <collision>
      <origin xyz="0.75 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.06" length="1.5"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.75 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.2" iyz="0" izz="0.2"/>
    </inertial>
  </link>

  <gazebo>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>joint1</joint_name>
      <topic>/planar_arm/joint1_cmd</topic>
      <p_gain>300.0</p_gain>
      <i_gain>5.0</i_gain>
      <d_gain>30.0</d_gain>
      <i_max>50</i_max>
      <i_min>-50</i_min>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>joint2</joint_name>
      <topic>/planar_arm/joint2_cmd</topic>
      <p_gain>300.0</p_gain>
      <i_gain>5.0</i_gain>
      <d_gain>30.0</d_gain>
      <i_max>50</i_max>
      <i_min>-50</i_min>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>joint3</joint_name>
      <topic>/planar_arm/joint3_cmd</topic>
      <p_gain>300.0</p_gain>
      <i_gain>5.0</i_gain>
      <d_gain>30.0</d_gain>
      <i_max>50</i_max>
      <i_min>-50</i_min>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher">
      <joint_name>joint1</joint_name>
      <joint_name>joint2</joint_name>
      <joint_name>joint3</joint_name>
    </plugin>
  </gazebo>

</robot>